# Copy to .env for local dev:  cp .env.example .env  then fill in your key.

# Your PseudoGram API key (from POST /v1/keygen). Required.
PSEUDOGRAM_API_KEY=

# The mock API base URL. Leave as-is.
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Local storage. SQLite is fine for dev; Render sets a Postgres URL instead.
DATABASE_URL=sqlite:///./linkplease.db

# Reject webhooks whose HMAC signature doesn't match (Part B).
VERIFY_SIGNATURE=true
